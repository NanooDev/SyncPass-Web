# Desarrollo con el BFF DE ESTE REPO (se commitea).
# `npm run dev` levanta el front contra http://localhost:8080
# (BFF local: `cd bff && ./gradlew bootRun`).
#
# Precedencia de Vite en dev (verificada con loadEnv):
#   .env.development.local > .env.development > .env.local > .env
# Este archivo GANA a .env.local. Para usar el BFF DESPLEGADO en CasaOS,
# comenta la línea VITE_BFF_URL de aquí (entonces aplica .env.local)
# y reinicia `npm run dev`.
VITE_BFF_URL=http://localhost:8080

